{
  "name": "free-kick-legend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kick District by Calynx Studio - swipe-to-shoot pixel football game",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:deploy": "playwright test --grep-invert @stress",
    "test:release": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^8.1.4"
  }
}
